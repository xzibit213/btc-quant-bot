# ─── BINANCE API KEYS ────────────────────────────────────────────────────────
# Get these from: Binance → Profile → API Management
# IMPORTANT: Enable "Futures Trading" permission. Disable "Withdrawals".
# Whitelist your server IP address for extra security.

BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# ─── MODE ─────────────────────────────────────────────────────────────────────
# Set TESTNET=true to run on Binance Futures Testnet (https://testnet.binancefuture.com)
# Set TESTNET=false only when you are ready to trade with real money
TESTNET=true

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=5000
